{
  "expo": {
    "name": "Klefkey",
    "slug": "klefkey",
    "scheme": "klefkey",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.klefkey.vault",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow Klefkey to use Face ID for secure vault authentication.",
        "NSPhotoLibraryUsageDescription": "Allow Klefkey to access and lock your photos in the secure vault.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.klefkey.vault",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#ffffff"
      },
      "statusBar": {
        "barStyle": "dark-content",
        "backgroundColor": "#ffffff",
        "translucent": true
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Klefkey to use Face ID for secure vault authentication."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Klefkey to access and lock your photos in the secure vault.",
          "savePhotosPermission": "Allow Klefkey to save photos."
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "a1ee16ec-2885-425b-bc5b-391d82b85867"
      }
    }
  }
}
